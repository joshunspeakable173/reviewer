{
  "type": "object",
  "properties": {
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "run_status": {
      "type": "string",
      "enum": ["ok", "partial", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "repair_mode": {
      "type": "string",
      "enum": ["plan", "overlay"]
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parser_finding_id": {
            "type": "string",
            "minLength": 1
          },
          "issue_summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["repaired", "mitigated", "partially_mitigated", "requires_reprocess", "not_repairable"]
          },
          "action": {
            "type": "string",
            "enum": [
              "write_repaired_overlay_artifact",
              "prefer_existing_fallback",
              "add_reviewer_overlay",
              "requires_deterministic_preprocess_change",
              "cannot_address_safely"
            ]
          },
          "reviewer_guidance": {
            "type": "string",
            "minLength": 1
          },
          "preferred_source_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "avoid_source_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification_steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "residual_risk": {
            "type": "string",
            "minLength": 1
          },
          "repaired_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$",
                  "minLength": 1
                },
                "artifact_type": {
                  "type": "string",
                  "enum": ["text", "table_csv", "table_markdown", "caption", "equation", "crossref", "other"]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "source_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "confidence": {
                  "type": "string",
                  "enum": ["high", "medium", "low"]
                },
                "caveats": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "filename",
                "artifact_type",
                "description",
                "content",
                "source_paths",
                "confidence",
                "caveats"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "parser_finding_id",
          "issue_summary",
          "status",
          "action",
          "reviewer_guidance",
          "preferred_source_paths",
          "avoid_source_paths",
          "verification_steps",
          "residual_risk",
          "repaired_artifacts"
        ],
        "additionalProperties": false
      }
    },
    "reviewer_brief": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "paper_id",
    "run_status",
    "summary",
    "repair_mode",
    "repairs",
    "reviewer_brief",
    "limitations"
  ],
  "additionalProperties": false
}
